rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId} (matches request.auth.uid)
// Fields:
//   - uid: string (required, immutable) - Firebase Auth User ID
//   - email: string (required) - User's email address
//   - displayName: string (optional) - User's name
//   - createdAt: timestamp (required, immutable) - Account creation time
//   - updatedAt: timestamp (optional) - Last update time
//
// Subcollection: users/{userId}/bookmarks/{bookmarkId}
//   - bookId: string (required)
//   - pageNumber: number (required)
//   - title: string (optional)
//   - createdAt: timestamp (required)
//
// Subcollection: users/{userId}/notes/{noteId}
//   - bookId: string (required)
//   - pageNumber: number (required)
//   - noteText: string (required)
//   - selectedText: string (optional)
//   - color: string (optional)
//   - createdAt: timestamp (required)
//
// Subcollection: users/{userId}/reading_progress/{bookId}
//   - lastPage: number (required)
//   - totalPages: number (required)
//   - updatedAt: timestamp (required)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidEmail(email) {
      return email is string && email.size() >= 3 && email.size() <= 100;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.uid == request.auth.uid
                    && isValidEmail(request.resource.data.email);
      allow update: if isOwner(userId)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);

      // User bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }

      // User notes subcollection
      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      // User reading progress subcollection
      match /reading_progress/{bookId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}

